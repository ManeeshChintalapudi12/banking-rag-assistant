# Copy this file to .env and fill in values as needed.

# "local" runs fully offline with a deterministic embedding and an
# extractive answerer — no API key required. Set to "openai" to use
# real OpenAI embeddings + chat completions for production-quality answers.
LLM_PROVIDER=local

# Only required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DOCS_DIR=data/sample_docs
INDEX_DIR=data/index

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
